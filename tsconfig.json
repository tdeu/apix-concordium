{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@concordium/web-sdk/nodejs": ["node_modules/@concordium/web-sdk/lib/esm/pub/nodejs.d.ts"],
      "@x402/concordium/exact/facilitator": ["node_modules/@x402/concordium/dist/cjs/exact/facilitator/index.d.ts"],
      "@x402/concordium/exact/client": ["node_modules/@x402/concordium/dist/cjs/exact/client/index.d.ts"],
      "@x402/core/http": ["node_modules/@x402/core/dist/cjs/http/index.d.ts"],
      "@x402/core/types": ["node_modules/@x402/core/dist/cjs/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/__tests__"]
}

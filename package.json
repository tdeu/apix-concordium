{
  "name": "apix-concordium",
  "version": "0.1.0",
  "description": "APIX Verifier on Concordium: an agent that other agents pay (x402) to verify their code, with PASS/FAIL attestations recorded on Concordium and a Verified by Concordium badge.",
  "license": "MIT",
  "author": "Emt\u00e9e Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/tdeu/apix-concordium"
  },
  "bin": {
    "apix": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "start": "node dist/cli/index.js",
    "build:serverless": "esbuild src/serverless.ts --bundle --format=esm --platform=node --target=node22 --packages=external --outfile=dist/serverless.mjs"
  },
  "dependencies": {
    "@concordium/web-sdk": "12.0.3",
    "@x402/concordium": "2.32.0",
    "@x402/core": "~2.32.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.0",
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}

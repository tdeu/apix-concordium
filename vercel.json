{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{dist/**,package.json,node_modules/@concordium/**,node_modules/@x402/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
